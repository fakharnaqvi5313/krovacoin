
## <summary>policy for krovacoin</summary>


########################################
## <summary>
##	Transition to krovacoin.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`krovacoin_domtrans',`
	gen_require(`
		type krovacoin_t, krovacoin_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, krovacoin_exec_t, krovacoin_t)
')


########################################
## <summary>
##	Execute krovacoin server in the krovacoin domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`krovacoin_initrc_domtrans',`
	gen_require(`
		type krovacoin_initrc_exec_t;
	')

	init_labeled_script_domtrans($1, krovacoin_initrc_exec_t)
')


########################################
## <summary>
##	Search krovacoin lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`krovacoin_search_lib',`
	gen_require(`
		type krovacoin_var_lib_t;
	')

	allow $1 krovacoin_var_lib_t:dir search_dir_perms;
	files_search_var_lib($1)
')

########################################
## <summary>
##	Read krovacoin lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`krovacoin_read_lib_files',`
	gen_require(`
		type krovacoin_var_lib_t;
	')

	files_search_var_lib($1)
	read_files_pattern($1, krovacoin_var_lib_t, krovacoin_var_lib_t)
')

########################################
## <summary>
##	Manage krovacoin lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`krovacoin_manage_lib_files',`
	gen_require(`
		type krovacoin_var_lib_t;
	')

	files_search_var_lib($1)
	manage_files_pattern($1, krovacoin_var_lib_t, krovacoin_var_lib_t)
')

########################################
## <summary>
##	Manage krovacoin lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`krovacoin_manage_lib_dirs',`
	gen_require(`
		type krovacoin_var_lib_t;
	')

	files_search_var_lib($1)
	manage_dirs_pattern($1, krovacoin_var_lib_t, krovacoin_var_lib_t)
')


########################################
## <summary>
##	All of the rules required to administrate
##	a krovacoin environment
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
## <rolecap/>
#
interface(`krovacoin_admin',`
	gen_require(`
		type krovacoin_t;
		type krovacoin_initrc_exec_t;
		type krovacoin_var_lib_t;
	')

	allow $1 krovacoin_t:process { ptrace signal_perms };
	ps_process_pattern($1, krovacoin_t)

	krovacoin_initrc_domtrans($1)
	domain_system_change_exemption($1)
	role_transition $2 krovacoin_initrc_exec_t system_r;
	allow $2 system_r;

	files_search_var_lib($1)
	admin_pattern($1, krovacoin_var_lib_t)

')

